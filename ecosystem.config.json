{
    "apps": [
        {
            "name": "soff-web",
            "script": "node_modules/.bin/next",
            "args": "start -p 3003",
            "instances": 1,
            "exec_mode": "cluster",
            "watch": false,
            "max_memory_restart": "1G",
            "env": {
                "NODE_ENV": "production"
            }
        },
        {
            "name": "soff-scheduler",
            "script": "scripts/scheduler.js",
            "instances": 1,
            "watch": false,
            "max_memory_restart": "200M",
            "restart_delay": 5000,
            "env": {
                "NODE_ENV": "production"
            }
        }
    ]
}
