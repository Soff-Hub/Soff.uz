{
    "apps": [
        {
            "name": "soff-web",
            "script": "node_modules/.bin/next",
            "args": "start -p 3003",
            "instances": 1,
            "exec_mode": "cluster",
            "watch": false,
            "max_memory_restart": "1G",
            "env": {
                "NODE_ENV": "production"
            }
        },
        {
            "name": "soff-scheduler",
            "script": "scripts/scheduler.js",
            "instances": 1,
            "exec_mode": "fork",
            "watch": false,
            "autorestart": false,
            "cron_restart": "0 3 * * *",
            "max_memory_restart": "200M",
            "env": {
                "NODE_ENV": "production"
            }
        }
    ]
}
