{
    "name": "soffuz",
    "version": "1.0.0",
    "private": true,
    "author": "Soff Hub",
    "homepage": "https://soff.uz",
    "scripts": {
        "dev": "next dev  -p 2025",
        "build": "next build && node scripts/copy-to-standalone.js",
        "start": "npm-run-all --parallel start:server start:scheduler",
        "type-check": "tsc --noEmit",
        "type-check:watch": "tsc --noEmit --watch",
        "start:server": "next start -p 3003",
        "start:scheduler": "node scripts/scheduler.js",
        "build:analyze": "ANALYZE=true npm run build",
        "pm2:start": "pm2 start ecosystem.config.json",
        "pm2:stop": "pm2 stop ecosystem.config.json",
        "pm2:restart": "pm2 restart ecosystem.config.json",
        "pm2:delete": "pm2 delete ecosystem.config.json",
        "clean": "antd-tools run clean && rm -rf es lib coverage dist report.html",
        "compile": "npm run clean && antd-tools",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "deploy": "npm run build && npm run deploy:prepare",
        "deploy:prepare": "npm run deploy:prepare:unix || npm run deploy:prepare:win",
        "deploy:prepare:unix": "rm -rf ./deploy && cp -r ./.next/standalone ./deploy && cp -r ./.next/static ./deploy/.next/static && cp -r ./public ./deploy/public && mkdir -p ./deploy/scripts && cp -r ./scripts/* ./deploy/scripts/ && (cp .env.local ./deploy/.env || cp .env ./deploy/.env || true)",
        "deploy:prepare:win": "if exist deploy rmdir /s /q deploy && xcopy /e /i /y .next\\standalone deploy && xcopy /e /i /y .next\\static deploy\\.next\\static && xcopy /e /i /y public deploy\\public && if not exist deploy\\scripts mkdir deploy\\scripts && xcopy /e /i /y scripts deploy\\scripts && (if exist .env.local (copy .env.local deploy\\.env) else (if exist .env copy .env deploy\\.env))",
        "deploy:win": "npm run build && npm run deploy:prepare:win",
        "deploy:run": "cd ./deploy && set PORT=7733 && node scripts/start-standalone.js"
    },
    "dependencies": {
        "@ckeditor/ckeditor5-build-classic": "^41.4.2",
        "@ckeditor/ckeditor5-react": "^11.0.0",
        "@react-oauth/google": "^0.12.1",
        "@reduxjs/toolkit": "^2.11.2",
        "@tanstack/react-query": "^4.36.1",
        "ant-design": "^1.0.0",
        "antd": "^5.21.1",
        "axios": "^1.7.7",
        "cookie": "^1.0.2",
        "critters": "^0.0.23",
        "dayjs": "^1.11.13",
        "dompurify": "^3.3.1",
        "dotenv": "^17.2.2",
        "emoji-picker-react": "^4.16.1",
        "js-cookie": "^2.2.1",
        "jwt-decode": "^4.0.0",
        "motion": "^12.25.0",
        "next": "^12.3.4",
        "next-progress": "^2.3.1",
        "node-cron": "^3.0.3",
        "react": "18.2.0",
        "react-confetti": "^6.1.0",
        "react-dom": "18.2.0",
        "react-google-recaptcha-v3": "^1.11.0",
        "react-icons": "^5.5.0",
        "react-infinite-scroll-component": "^6.1.0",
        "react-joyride": "^2.8.1",
        "react-redux": "^9.2.0",
        "react-spinners": "^0.14.1",
        "react-use-websocket": "^4.13.0",
        "sass": "^1.45.2",
        "sharp": "^0.34.4",
        "swiper": "^11.0.5",
        "uuid": "^9.0.1",
        "yet-another-react-lightbox": "^3.21.7"
    },
    "devDependencies": {
        "@next/bundle-analyzer": "^15.5.4",
        "@playwright/test": "^1.56.0",
        "@rtk-query/codegen-openapi": "^2.2.0",
        "@sentry/nextjs": "^7.114.0",
        "@storybook/addon-essentials": "^7.6.20",
        "@storybook/addon-interactions": "^7.6.20",
        "@storybook/addon-links": "^7.6.20",
        "@storybook/addon-onboarding": "^1.0.11",
        "@storybook/blocks": "^7.6.20",
        "@storybook/nextjs": "^7.6.20",
        "@storybook/react": "^7.6.20",
        "@storybook/test": "^7.6.20",
        "@types/js-cookie": "^3.0.6",
        "@types/node": "^24.10.4",
        "@types/react": "18.2.25",
        "@types/react-dom": "18.2.25",
        "next-compose-plugins": "^2.2.1",
        "npm-run-all": "^4.1.5",
        "storybook": "^7.6.20",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    }
}
