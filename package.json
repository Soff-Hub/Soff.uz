{
    "name": "soffuz",
    "version": "1.0.0",
    "private": true,
    "author": "Soff Hub",
    "homepage": "https://soff.uz",
    "scripts": {
        "dev": "next dev -p 5050",
        "build": "node scripts/scheduler.js && next build && node scripts/copy-to-standalone.js",
        "start": "next start -p 5505",
        "type-check": "tsc --noEmit",
        "type-check:watch": "tsc --noEmit --watch",
        "deploy:local": "npm run build && node scripts/prepare-deploy.js --env local",
        "deploy:prod": "cross-env NODE_ENV=production node scripts/scheduler.js && next build && node scripts/copy-to-standalone.js && node scripts/prepare-deploy.js --env prod && node scripts/telegram-deploy.js",
        "deploy:run": "cd ./deploy && cross-env PORT=5505 HOSTNAME=localhost node server.js"
    },
    "dependencies": {
        "@ckeditor/ckeditor5-build-classic": "^41.4.2",
        "@ckeditor/ckeditor5-react": "^11.0.0",
        "@react-oauth/google": "^0.12.1",
        "@reduxjs/toolkit": "^2.11.2",
        "@tanstack/react-query": "^4.36.1",
        "ant-design": "^1.0.0",
        "antd": "^5.21.1",
        "axios": "^1.7.7",
        "cookie": "^1.0.2",
        "critters": "^0.0.23",
        "dayjs": "^1.11.13",
        "dompurify": "^3.3.1",
        "dotenv": "^17.2.2",
        "emoji-picker-react": "^4.16.1",
        "input": "^1.0.1",
        "js-cookie": "^2.2.1",
        "jwt-decode": "^4.0.0",
        "motion": "^12.25.0",
        "next": "^12.3.4",
        "next-progress": "^2.3.1",
        "node-cron": "^3.0.3",
        "react": "18.2.0",
        "react-confetti": "^6.1.0",
        "react-dom": "18.2.0",
        "react-google-recaptcha-v3": "^1.11.0",
        "react-icons": "^5.5.0",
        "react-infinite-scroll-component": "^6.1.0",
        "react-joyride": "^2.8.1",
        "react-redux": "^9.2.0",
        "react-spinners": "^0.14.1",
        "react-use-websocket": "^4.13.0",
        "sass": "^1.45.2",
        "sharp": "^0.34.4",
        "swiper": "^11.0.5",
        "telegram": "^2.26.22",
        "uuid": "^9.0.1",
        "yet-another-react-lightbox": "^3.21.7"
    },
    "devDependencies": {
        "@next/bundle-analyzer": "^15.5.4",
        "@rtk-query/codegen-openapi": "^2.2.0",
        "@types/js-cookie": "^3.0.6",
        "@types/node": "^24.10.4",
        "@types/react": "18.2.25",
        "@types/react-dom": "18.2.25",
        "archiver": "^7.0.1",
        "axios-retry": "^4.5.0",
        "cross-env": "^10.1.0",
        "form-data": "^4.0.5",
        "next-compose-plugins": "^2.2.1",
        "npm-run-all": "^4.1.5",
        "progress-stream": "^2.0.0",
        "shx": "^0.4.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    }
}