InDescription\":\"Xush kelibsiz.\",\"signedOut\":\"Chiqildi\",\"signInFailed\":\"Kirish amalga oshmadi\",\"copiedLink\":\"Havola nusxalandi\"},\"errors\":{\"NETWORK\":\"Internetga ulanib bo‘lmadi. Ulanishni tekshiring.\",\"TIMEOUT\":\"So‘rov juda uzoq davom etdi. Qayta urinib ko‘ring.\",\"UNAUTHORIZED\":\"Davom etish uchun tizimga kiring.\",\"FORBIDDEN\":\"Bu amalga ruxsatingiz yo‘q.\",\"NOT_FOUND\":\"Topilmadi.\",\"VALIDATION\":\"Kiritilgan ma’lumot noto‘g‘ri.\",\"RATE_LIMITED\":\"Juda ko‘p urinish. Biroz kutib, qayta urinib ko‘ring.\",\"SERVER\":\"Serverda xatolik. Birozdan keyin urinib ko‘ring.\",\"QUOTA_EXCEEDED\":\"Limit tugadi. Tarifni yangilang yoki keyinroq urinib ko‘ring.\",\"INSUFFICIENT_TOKENS\":\"Bu uchun tokenlar yetmaydi. Balansni to‘ldiring yoki tarifni o‘zgartiring.\",\"CARD_DECLINED\":\"Bank bu kartani rad etdi. Boshqa karta bilan urinib ko‘ring.\",\"CARD_UNSUPPORTED\":\"Bu turdagi karta qo‘llab-quvvatlanmaydi.\",\"CARD_INACTIVE\":\"Bu karta faol emas. Boshqasini qo‘shing.\",\"ORDER_INVALID\":\"Bu buyurtma endi yaroqsiz. Qaytadan boshlang.\",\"ORDER_NOT_FOUND\":\"Bunday buyurtma topilmadi.\",\"PAYMENT_UNAVAILABLE\":\"To‘lov vaqtincha ishlamayapti. Birozdan keyin urinib ko‘ring.\",\"UNKNOWN\":\"Kutilmagan xatolik yuz berdi.\"},\"errorPage\":{\"notFound\":{\"title\":\"Bunday sahifa yo‘q\",\"description\":\"Havola eskirgan yoki manzilda xatolik bor bo‘lishi mumkin. Yaratmoqchi bo‘lgan narsangiz esa bir prompt narida.\"},\"crash\":{\"title\":\"Bizning tomonda xatolik yuz berdi\",\"description\":\"Bu sizning aybingiz emas. Qayta urinib ko‘ring — takrorlansa, bir necha daqiqadan so‘ng qayting.\"},\"goHome\":\"Bosh sahifaga\",\"browseServices\":\"Xizmatlarni ko‘rish\",\"retry\":\"Qayta urinish\",\"reference\":\"Xatolik kodi: {digest}\"},\"billing\":{\"title\":\"Tarif va to‘lovlar\",\"noSubscription\":\"Faol tarif yo‘q\",\"current\":{\"label\":\"Sizning tarifingiz\",\"active\":\"Faol\",\"cancelled\":\"Bekor qilingan\",\"renewsOn\":\"{date} da yangilanadi\",